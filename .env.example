OPENAI_API_KEY=
# Embeddings: auto (fastembed if installed, else lexical hash) | fastembed | hash | azure
EMBEDDING_PROVIDER=auto
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# Optional: override the per-model minimum similarity for retrieved chunks
RETRIEVAL_MIN_SCORE=
# PostgreSQL (required). Create the database first: createdb -U postgres knowledge_assistant
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/knowledge_assistant
# Used by tests/test_api.py; its tables are dropped and recreated on every run
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/knowledge_assistant_test
# Azure OpenAI in Microsoft Foundry. Endpoint and key: Foundry portal > your
# resource > Overview (or Azure portal > Keys and Endpoint). Deployment names are
# the names you gave the model deployments, not the model names.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Only used when EMBEDDING_PROVIDER=azure (e.g. a text-embedding-3-small deployment)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Answers: auto (Azure when the three settings above are set) | azure | none (top passage only)
LLM_PROVIDER=auto

# Seconds allowed for each Review Insights Agent call.
AGENT_TIMEOUT=120
# Backend log level: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
